{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Aftiktuna Editor",
            "type": "cargo",
            "command": "run",
            "args": [
                "--package",
                "aftiktuna-editor-three-d",
                "--bin",
                "aftiktuna-editor-three-d",
                "--",
                "${file}"
            ],
            "problemMatcher": [
                "$rustc"
            ],
        },
        {
            "label": "rust: cargo fmt",
            "type": "cargo",
            "command": "fmt",
            "problemMatcher": [
                "$rustc"
            ],
            "group": "build",
        },
        {
            "label": "rust: cargo clippy",
            "type": "cargo",
            "command": "clippy",
            "args": [
                "--workspace"
            ],
            "problemMatcher": [
                "$rustc"
            ],
            "group": "build",
        }
    ]
}
