{
  "type": "object",
  "properties": {
    "effect": {
      "type": "object",
      "properties": {
        "speaker_morale": { "$ref": "#/$defs/morale_pair" },
        "target_morale": { "$ref": "#/$defs/morale_pair" },
        "set_talked_about_enough_fuel": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "description": { "type": "string" },
    "dialogue": { "$ref": "./parts/dialogue_list.json" },
    "next": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [ "response", "continuation"]
          },
          "condition": { "$ref": "./parts/dialogue_condition_list.json" },
          "node": {
            "oneOf": [
              { "$ref": "./parts/name_path.json" },
              { "$ref": "#" }
            ]
          }
        },
        "required": [ "kind", "node" ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "morale_pair": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number", "minimum": 1 }
      ],
      "additionalItems": false
    }
  }
}
